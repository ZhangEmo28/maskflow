# Copy to .env on the production host and replace every replace-me value.

ASPNETCORE_ENVIRONMENT=Production

SAM3_INTERNAL_KEY=replace-me-with-a-unique-random-sam-key
MASKFLOW_ADMIN_API_KEY=replace-me-with-a-unique-random-admin-key
SAM3_REQUIRE_INTERNAL_KEY=true

API_HOST_PORT=8000
WEB_HOST_PORT=3000
SAM_HOST_PORT=8001
MYSQL_HOST_PORT=3307
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Only the Web UI is public by default. Put TLS/reverse proxy in front of it.
WEB_BIND_ADDRESS=0.0.0.0
API_BIND_ADDRESS=127.0.0.1
SAM_BIND_ADDRESS=127.0.0.1
MYSQL_BIND_ADDRESS=127.0.0.1
MINIO_BIND_ADDRESS=127.0.0.1

MASKFLOW_CORS_ORIGINS=https://replace-me.example.com
SAM3_CORS_ORIGINS=https://replace-me.example.com

MASKFLOW_BILLING_DEV_MODE=false

# Public HTTPS origin: used in mail links and as the MCP/OAuth issuer for ChatGPT / Claude connectors.
# Mail is required for password reset and project invitations in production.
MASKFLOW_PUBLIC_URL=https://replace-me.example.com
MASKFLOW_SMTP_HOST=replace-me.smtp.example.com
MASKFLOW_SMTP_PORT=587
MASKFLOW_SMTP_USERNAME=replace-me
MASKFLOW_SMTP_PASSWORD=replace-me-with-the-smtp-password
MASKFLOW_SMTP_FROM=MaskFlow <no-reply@replace-me.example.com>
MASKFLOW_SMTP_SECURITY=starttls
MASKFLOW_AI_DAILY_LIMIT=10000

MYSQL_ROOT_PASSWORD=replace-me-with-a-unique-random-mysql-root-password
MYSQL_PASSWORD=replace-me-with-a-unique-random-mysql-user-password

MINIO_ROOT_USER=maskflow
MINIO_ROOT_PASSWORD=replace-me-with-a-unique-random-minio-password
MINIO_DATA_PATH=/var/lib/maskflow/minio

# Model training (docker compose --profile training up -d)
# Admin emails allowed to download/delete base weights (comma separated); empty = first registered account.
MASKFLOW_ADMIN_EMAILS=
MASKFLOW_TRAIN_MIN_IMAGES=20
MASKFLOW_TRAIN_MIN_PER_CLASS=10
# TRAIN_WEIGHT_BASE_URL=https://github.com/ultralytics/assets/releases/download/v8.4.0
